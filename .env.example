DATABASE_URL=""
# Direct, non-pooled administrative URL used only by migrations and database tooling.
MIGRATION_DATABASE_URL=""

# Neon Auth URL from Console > Auth > Configuration (ends in /auth).
NEON_AUTH_BASE_URL=""
# Random secret of at least 32 characters. Server only.
NEON_AUTH_COOKIE_SECRET=""
# Exact frontend origin; use your HTTPS production domain in Vercel.
APP_URL="http://localhost:3000"
# Separate restricted database credential, provisioned with db:provision-runtime.
RUNTIME_DATABASE_URL=""

# API envs
# Server-only ExerciseDB / AscendAPI credentials. Never use VITE_ here.
RAPIDAPI_KEY=""
RAPIDAPI_HOST="edb-with-videos-and-images-by-ascendapi.p.rapidapi.com"

# Web Push (server only). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@example.com"
