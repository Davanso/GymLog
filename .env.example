# Backend only. Copy to .env and paste the complete Neon connection URL.
# PostgreSQL 18 — AWS São Paulo (sa-east-1).
# Never prefix this variable with VITE_.
DATABASE_URL=""

# Optional administrative URL, used only by db:migrate / db:verify / db:status.
# If omitted, those commands use DATABASE_URL. Never prefix with VITE_.
# MIGRATION_DATABASE_URL=""
