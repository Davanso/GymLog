{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["gru1"],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path+",
      "destination": "/api/auth?path=:path"
    },
    {
      "source": "/((?!api(?:/|$)|src/|node_modules/|@|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
