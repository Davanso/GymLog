{
  "name": "gymlog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "dev:full": "vercel dev",
    "fmt": "oxfmt . --config oxfmt.config.mjs --write",
    "fmt:check": "oxfmt . --config oxfmt.config.mjs --check",
    "test:backend": "tsx --test server/__tests__/*.test.ts",
    "db:migrate": "node --env-file=.env scripts/database.mjs",
    "db:verify": "node --env-file=.env scripts/verify-database.mjs",
    "db:status": "node --env-file=.env scripts/database-status.mjs",
    "db:provision-runtime": "node --env-file=.env scripts/provision-runtime.mjs",
    "lint": "eslint .",
    "prepare": "husky",
    "commit": "git commit",
    "commitlint": "commitlint",
    "test:workouts:db": "node --env-file=.env --import tsx --test server/integration/workouts.test.ts",
    "catalog:sync": "node --env-file=.env --import tsx scripts/sync-exercise-catalog.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vercel": "^59.11.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
